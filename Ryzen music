local HOVER_NAME = "Hoverboard" -- change this if your game uses another name
local COLOR_REMOTE = "1Player1sCa1r"
local RAINBOW_DELAY = 0.25 -- bigger number = slower and safer

for index, button in ipairs(tabButtons) do button.LayoutOrder = index * 10 end

local function sideButton(text, order)
	return glass("TextButton", sidebar, 0, 0, 112, 34, {Text = text, TextSize = 12, LayoutOrder = order})
end

local hoverButton = sideButton("🛸 Hoverboard", 61)
local rainbowButton = sideButton("🌈 Rainbow: OFF", 62)
local removeButton = sideButton("🗑 Remove ride", 63)

hoverButton.MouseButton1Click:Connect(function()
	local sent = fire(VEHICLE_REMOTE, HOVER_NAME)
	status.Text = sent and "Hoverboard requested" or "Hoverboard remote not found"
end)

local badgeGradient = badge:FindFirstChildOfClass("UIGradient")
local normalBadge = badgeGradient.Color
local rainbowRun = 0
local rainbowOn = false

local function setRainbow(on)
	rainbowOn = on
	rainbowRun = rainbowRun + 1
	local myRun = rainbowRun
	rainbowButton.Text = on and "🌈 Rainbow: ON" or "🌈 Rainbow: OFF"
	paint(rainbowButton, on)

	if not on then
		badgeGradient.Color = normalBadge
		edge.Color = ICE
		for _, bar in ipairs(bars) do bar.BackgroundColor3 = ICE end
		return
	end

	task.spawn(function()
		local hue = 0
		while rainbowRun == myRun and gui.Parent do
			hue = (hue + 0.045) % 1
			local color = Color3.fromHSV(hue, 1, 1)
			if not fire(COLOR_REMOTE, "NoMotorColor", color) then
				setRainbow(false)
				status.Text = "Colour remote not found"
				break
			end
			-- The interface glows in the same colour
			badgeGradient.Color = ColorSequence.new(color, Color3.fromHSV((hue + 0.2) % 1, 0.8, 0.9))
			edge.Color = color
			for _, bar in ipairs(bars) do bar.BackgroundColor3 = color end
			task.wait(RAINBOW_DELAY)
		end
	end)
end

rainbowButton.MouseButton1Click:Connect(function()
	status.Text = rainbowOn and "Rainbow off" or "Rainbow on"
	setRainbow(not rainbowOn)
end)

removeButton.MouseButton1Click:Connect(function()
	setRainbow(false)
	local sent = fire(VEHICLE_REMOTE, "Delete NoMotorVehicle")
	status.Text = sent and "Ride removed" or "Vehicle remote not found"
end)
