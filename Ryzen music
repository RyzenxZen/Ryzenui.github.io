local function morph(toIcon)
	local big = {Size = UDim2.fromOffset(520 * fit, 320 * fit), Position = window.Position}
	local small = {Size = UDim2.fromOffset(50, 50), Position = mini.Position}
	local from, to = small, big
	if toIcon then from, to = big, small end
	ghost.Size, ghost.Position = from.Size, from.Position
	ghostCorner.CornerRadius = UDim.new(0, toIcon and 20 * fit or 15)
	ghost.Visible = true
	anim(ghostCorner, 0.42, {CornerRadius = UDim.new(0, toIcon and 15 or 20 * fit)})
	anim(ghost, 0.42, to, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
	task.wait(0.42)
end

local function minimize()
	if busy then return end
	busy = true
	veil.Visible = true
	anim(veil, 0.15, {BackgroundTransparency = 0})
	task.wait(0.15)
	window.Visible = false
	morph(true)
	ghost.Visible = false
	mini.Visible = true
	miniScale.Scale = 1.25
	anim(miniScale, 0.35, {Scale = 1}, Enum.EasingStyle.Back)
	busy = false
end

local function maximize()
	if busy then return end
	busy = true
	mini.Visible = false
	morph(false)
	windowScale.Scale = fit
	veil.BackgroundTransparency, veil.Visible = 0, true
	window.Visible = true
	ghost.Visible = false
	anim(veil, 0.28, {BackgroundTransparency = 1})
	task.wait(0.28)
	veil.Visible = false
	busy = false
end

