local connections = {}
local windowScale = make("UIScale", {}, window)
local miniScale = make("UIScale", {}, mini)
local fit = 1

local function tween(object, goal)
	TweenService:Create(object, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), goal):Play()
end

-- Keeps an element fully inside the screen
local function keepInside(object, width, height)
	local screen = gui.AbsoluteSize
	if screen.X == 0 then return end
	local maxX = math.max(0, (screen.X - width) / 2 - 8)
	local maxY = math.max(0, (screen.Y - height) / 2 - 8)
	local p = object.Position
	object.Position = UDim2.new(0.5, math.clamp(p.X.Offset, -maxX, maxX), 0.5, math.clamp(p.Y.Offset, -maxY, maxY))
end

-- Resizes the window for phone, tablet or PC
local function refit()
	local screen = gui.AbsoluteSize
	if screen.X == 0 then return end
	fit = math.min(screen.X * 0.92 / 520, screen.Y * 0.84 / 320, 1.15)
	windowScale.Scale = fit
	keepInside(window, 520 * fit, 320 * fit)
	keepInside(mini, 50, 50)
end

local function draggable(handle, target, getSize)
	local active, startPosition, origin
	local moved = false
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			active, startPosition, origin, moved = input, input.Position, target.Position, false
		end
	end)
	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if not active then return end
		local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement
			and active.UserInputType == Enum.UserInputType.MouseButton1
		if input ~= active and not isMouse then return end
		local delta = input.Position - startPosition
		if delta.Magnitude > 6 then moved = true end
		if moved then
			target.Position = origin + UDim2.fromOffset(delta.X, delta.Y)
			keepInside(target, getSize())
		end
	end))
	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if active and (input == active or input.UserInputType == Enum.UserInputType.MouseButton1) then
			active = nil
		end
	end))
	return function() return moved end
end

