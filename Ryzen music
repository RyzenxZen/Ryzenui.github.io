-- Game remotes
local function fire(remoteName, ...)
	local folder = ReplicatedStorage:FindFirstChild("RE")
	local remote = folder and folder:FindFirstChild(remoteName)
	if not remote then return false end
	return (pcall(remote.FireServer, remote, ...))
end

local selected, playerMode = nil, false
local rows = {}

local function paint(button, on)
	button.BackgroundColor3 = on and BLUE or GLASS
	button.BackgroundTransparency = on and 0.2 or 0.9
end

local function play(id, name)
	if fire(VEHICLE_REMOTE, "PickingScooterMusicText", id) then
		status.Text = "Playing: " .. name
	else
		status.Text = "Music remote not found in this game"
	end
end

local function filterSongs()
	local query = string.lower(search.Text)
	for button, song in pairs(rows) do
		button.Visible = string.find(string.lower(song.Name), query, 1, true) ~= nil
	end
end

local function loadSongs(songs)
	for button in pairs(rows) do button:Destroy() end
	rows = {}
	for index, song in ipairs(songs) do
		local row = glass("TextButton", list, 0, 0, 346, 34, {Text = "   ♪  " .. song.Name,
			TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamMedium,
			LayoutOrder = index, TextTruncate = Enum.TextTruncate.AtEnd})
		rows[row] = song
		paint(row, song == selected)
		row.MouseButton1Click:Connect(function()
			selected = song
			for button, data in pairs(rows) do paint(button, data == selected) end
			play(song.ID, song.Name)
		end)
	end
	list.CanvasPosition = Vector2.new(0, 0)
	filterSongs()
end

local function showPlayer(on)
	playerMode = on
	search.Visible, list.Visible = not on, not on
	idBox.Visible, idHelp.Visible = on, on
