-- PART 2/3 : Glass interface

local BLUE = Color3.fromRGB(40, 140, 255)
local ICE = Color3.fromRGB(185, 225, 255)
local GLASS = Color3.fromRGB(115, 175, 255)
local WHITE = Color3.new(1, 1, 1)

local function make(class, props, parent)
	local object = Instance.new(class)
	for key, value in pairs(props) do object[key] = value end
	object.Parent = parent
	return object
end

local function round(object, radius)
	make("UICorner", {CornerRadius = UDim.new(0, radius)}, object)
end

local function stroke(object, transparency, thickness)
	return make("UIStroke", {Color = ICE, Transparency = transparency, Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, object)
end

local function gradient(object, top, bottom, rotation)
	make("UIGradient", {Color = ColorSequence.new(top, bottom), Rotation = rotation or 90}, object)
end

-- Creates a frosted glass element at a fixed place
local function glass(class, parent, x, y, w, h, extra)
	local props = {Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = GLASS, BackgroundTransparency = 0.88, BorderSizePixel = 0}
	if class == "TextButton" or class == "TextBox" then
		props.Font, props.TextSize, props.TextColor3, props.Text = Enum.Font.GothamBold, 13, WHITE, ""
	end
	if class == "TextButton" then props.AutoButtonColor = true end
	if class == "TextBox" then props.ClearTextOnFocus = false end
	for key, value in pairs(extra or {}) do props[key] = value end
	local object = make(class, props, parent)
	round(object, 10)
	stroke(object, 0.75)
	return object
end

local function label(parent, text, size, x, y, w, h, extra)
	local props = {Text = text, TextSize = size, Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, TextColor3 = WHITE,
		Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd}
	for key, value in pairs(extra or {}) do props[key] = value end
	return make("TextLabel", props, parent)
end

