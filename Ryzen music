local function setPlaying(on)
	for _, t in ipairs(barTweens) do t:Cancel() end
	barTweens = {}
	for i, bar in ipairs(bars) do
		bar.Size = UDim2.fromOffset(4, 4)
		if on then
			local t = TweenService:Create(bar, TweenInfo.new(0.22 + i * 0.07, Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut, -1, true), {Size = UDim2.fromOffset(4, 14 + (i % 2) * 9)})
			t:Play()
			table.insert(barTweens, t)
		end
	end
end

