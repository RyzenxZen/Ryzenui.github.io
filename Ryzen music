	if not object:IsA("TextButton") then return end
	local line = object:FindFirstChildOfClass("UIStroke")
	if not line then return end
	local function set(input, value)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch then
			anim(line, 0.18, {Transparency = value})
		end
	end
	object.InputBegan:Connect(function(input) set(input, 0.05) end)
	object.InputEnded:Connect(function(input) set(input, 0.75) end)
end

